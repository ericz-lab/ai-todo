# Every variable the service reads. Real values live in .env (ignored by git) or, inside an
# ai-space workspace, in <workspace>/data/ai-todo/space.env which ai-space generates from
# space.yaml. Never put real values in this file.

# Set by ai-space from space.yaml (service.port). Bind 127.0.0.1 only.
PORT=8970

# Public URL of the app, used for the links the widget returns.
PUBLIC_BASE=https://ai-todo.example.com

# Parsing, execution and chat inherit the default model in ai-space Settings.
# Legacy TODO_MODEL values are ignored.

# Let an execution search the web (WebSearch, WebFetch); 0 turns it off.
TODO_WEB=1

# Wall-clock cap of one execution, seconds.
TODO_EXECUTE_TIMEOUT=600

# Language of the page and the model's answers.
TODO_LANG=zh

# IANA zone the dates are read in when the page does not send its own.
TODO_TZ=Asia/Shanghai

# Provided by ai-space (space.env); do not set by hand.
# SPACE_API_URL=http://127.0.0.1:8700
# SPACE_APP_TOKEN=
# DATABASE_URL=sqlite:///path/to/main.db

# Image storage, provisioned by Space; bare checkouts default to data/blobs.
# BLOB_URL=s3://bucket/ai-todo/
# S3_ENDPOINT=https://your-s3-endpoint
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
