#!/bin/bash
# Bare-repository hook on the host: checkout -> bun install -> reinstall the unit -> restart ->
# ask ai-space to re-read space.yaml. Install as ~/ai-todo.git/hooks/post-receive (chmod +x).
set -e; unset GIT_DIR
APP=ai-todo
WORK=$HOME/.ai-space/apps/$APP
mkdir -p "$WORK"
git --git-dir=$HOME/$APP.git --work-tree=$WORK checkout -f main
cd "$WORK"
~/.bun/bin/bun install --production --frozen-lockfile 2>&1 | tail -1
mkdir -p ~/.config/systemd/user
sed "s|@DIR@|$WORK|g" deploy/app.service > ~/.config/systemd/user/$APP.service
systemctl --user daemon-reload
systemctl --user restart $APP
echo "  -> $APP restarted"
TOKEN=$(grep "^SPACE_API_TOKEN=" "$HOME/.ai-space/.env" | cut -d= -f2-)
curl -sS -m 20 -X POST "http://127.0.0.1:8700/api/apps/$APP/sync" -H "authorization: Bearer $TOKEN" -o /dev/null -w "  -> ai-space sync HTTP %{http_code}\n" || echo "  -> ai-space sync skipped"
